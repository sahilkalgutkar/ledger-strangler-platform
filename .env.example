# Host ports the compose stack publishes. Every one is overridable. 9042, 5672,
# 9200 and 5601 in particular are usually already taken on a machine that has
# run a Cassandra, a RabbitMQ or an ELK stack for anything else, and the whole
# `docker compose up` aborts on the first collision.
#
# Only the host side moves -- inside the compose network the Gateway still
# reaches the services, and the services still reach Postgres, Cassandra and
# RabbitMQ, on the standard ports. The curls in the README go through the
# Gateway, so in practice GATEWAY_HOST_PORT and NOTIFICATIONS_SERVICE_HOST_PORT
# are the two you need to know about.
#
# Copy this to .env, or set them inline:
#   GATEWAY_HOST_PORT=5400 docker compose up --build

POSTGRES_LEGACY_HOST_PORT=15432
POSTGRES_NOTIFICATIONS_HOST_PORT=15433
CASSANDRA_HOST_PORT=9042
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
LEGACY_MONOLITH_HOST_PORT=5299
ACCOUNTS_SERVICE_HOST_PORT=5301
NOTIFICATIONS_SERVICE_HOST_PORT=5302
GATEWAY_HOST_PORT=5300
ELASTICSEARCH_HOST_PORT=9200
LOGSTASH_HOST_PORT=5044
KIBANA_HOST_PORT=5601
